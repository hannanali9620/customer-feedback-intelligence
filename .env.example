# Flask settings
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-local-string

# V2 Optional Local Settings (for capable PCs)
ENABLE_DISTILBERT=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# V3 Optional Cloud Settings (used ONLY when valid credentials are present)
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
